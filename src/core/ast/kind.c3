module analyzer::core::ast;

import std::collections::list;

enum NodeKind : char
{
	ERROR,

	ATTRDEF_DECL,
	ATTRIBUTE_DECL,
	CONTRACT_DECL,
	STRUCT_DECL,
	ENUM_DECL,
	VAR_DECL,
	MODULE_DECL,
	IMPORT_DECL,
	ALIAS_DECL,
	TYPEDEF_DECL,
	FN_DECL,
	MACRO_DECL,
	FAULT_DECL,
	FAULTDEF_DECL,
	GENERIC_DECL,
	INTERFACE_DECL,
	CT_EXPAND_DECL,
	CT_ASSERT_DECL,
	BODY_PARAM_DECL,

	COMPOUND_STMT,
	IF_STMT,
	CT_IF_STMT,
	SWITCH_STMT,
	CT_SWITCH_STMT,
	CASE_STMT,
	NEXTCASE_STMT,
	CONTINUE_BREAK_STMT,
	DEFAULT_STMT,
	RETURN_STMT,
	FOR_STMT,
	CT_FOR_STMT,
	WHILE_STMT,
	DO_WHILE_STMT,
	FOREACH_STMT,
	CT_FOREACH_STMT,
	EXPR_STMT,
	NOP_STMT,
	CT_ASSERT_STMT,
	CT_ERROR_STMT,
	CT_ECHO_STMT,
	DEFER_STMT,
	ASSERT_STMT,
	CT_EXPAND_STMT,
	ASM_BLOCK_STMT,

	CALL_EXPR,
	BINARY_EXPR,
	UNARY_EXPR,
	POST_UNARY_EXPR,
	IDENT_EXPR,
	TYPE_EXPR,
	PATH_EXPR,
	EXPR_LIST,
	LITERAL_EXPR,
	CONTRACT_EXPR,
	COND_EXPR,
	TRY_EXPR,
	CATCH_EXPR,
	TERNARY_EXPR,
	MACRO_BODY_EXPR,
	BUILTIN_EXPR,
	COMPILER_CONST_EXPR,
	SPLAT_EXPR,
	NAMED_ARG_EXPR,
	VASPLAT_EXPR,
	EVAL_NAMED_ARG_EXPR,
	CT_EVAL_EXPR,
	LAMBDA_EXPR,
	GENERIC_IDENT_EXPR,
	CAST_EXPR,
	GROUP_EXPR,
	DESIGNATOR_EXPR,
	DESIGNATED_INITIALIZER_EXPR,
	INITIALIZER_LIST_EXPR,
	COMPOUND_LITERAL_EXPR,
	ACCESS_EXPR,
	MAYBE_DEREF_EXPR,
	RANGE_EXPR,
	OPTIONAL_EXPR,
	CT_DEFINED_EXPR,
	CT_FEATURE_EXPR,
	LENGTHOF_EXPR,
	CT_STRINGIFY_EXPR,
	VAARG_EXPR,
	OVERLOAD_EXPR,
	CT_REFLECT_EXPR,

	CONTRACT_PARAM,
}

fn bool NodeKind.is_decl(self) @inline
{
	return self.ordinal >= NodeKind.ATTRDEF_DECL.ordinal && self.ordinal <= NodeKind.BODY_PARAM_DECL.ordinal;
}

fn bool NodeKind.is_stmt(self) @inline
{
	return self.ordinal >= NodeKind.COMPOUND_STMT.ordinal && self.ordinal <= NodeKind.ASM_BLOCK_STMT.ordinal;
}

fn bool NodeKind.is_expr(self) @inline
{
	return self.ordinal >= NodeKind.CALL_EXPR.ordinal && self.ordinal <= NodeKind.CT_REFLECT_EXPR.ordinal;
}
