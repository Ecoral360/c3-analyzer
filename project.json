{
  "langrev": "1",
  "warnings": [ "no-unused" ],
  "dependency-search-paths": [ "lib" ],
  "authors": [ "John Doe <john.doe@example.com>" ],
  "version": "0.1.0",
  "sources": [ "src/**", "bench/benchmark.c3" ],
  "test-sources": [ "test/**" ],
  "build-dir": "build",
  "output": "build",
  "features": ["SEMA"],
  "targets": {
    "c3-analyzer": {
      "type": "executable",
			"features": [ "ANALYZER_CLI", "ANALYZER_PRINT" ],
      "dependencies": [ "seali" ]
    },
    "c3-analyzer-lib": {
      "type": "static-lib",
      "features": [ "ANALYZER_LIB"]
    }
  },
  "cpu": "generic",
  "opt": "O0",
  "debug-info": "full"
}
